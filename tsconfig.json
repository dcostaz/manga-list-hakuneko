{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "lib": ["es2022"],
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"]
  },
  "include": ["src/runtime/apiwrappers/**/*.cjs"],
  "exclude": ["dist", "node_modules", "tests", "scripts", "src/runtime/web"]
}
