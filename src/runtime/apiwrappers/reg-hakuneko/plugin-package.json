{
  "pluginName": "hakuneko",
  "displayName": "HakuNeko",
  "pluginType": "adapter",
  "pluginContractVersion": "4.1.0",
  "hostApiVersion": "1.0.0",
  "capabilities": [
    "file-path",
    "search.query",
    "enrich",
    "sync.pull",
    "sync.push",
    "sync.list",
    "watch.list",
    "subscribe.add",
    "watch.summary"
  ],
  "iconPath": "images/hakuneko-icon.svg",
  "entrypoints": {
    "pluginModule": "apiwrappers/reg-hakuneko/hakuneko-plugin.cjs",
    "settingsFile": "apiwrappers/reg-hakuneko/hakuneko-plugin-settings.json"
  },
  "filePathOptions": {
    "fields": [
      {
        "key": "downloadBaseDir",
        "label": "Manga base directory",
        "kind": "directory"
      },
      {
        "key": "bookmarksPath",
        "label": "Hakuneko bookmarks file",
        "kind": "file"
      },
      {
        "key": "chaptermarksPath",
        "label": "Hakuneko chaptermarks file",
        "kind": "file"
      }
    ]
  },
  "syncOptions": {
    "statusVocabulary": {
      "push": {
        "READING": "bookmarks",
        "COMPLETED": "bookmarks",
        "PLAN_TO_READ": "bookmarks",
        "ON_HOLD": "bookmarks",
        "DROPPED": "bookmarks",
        "RE_READING": "bookmarks"
      },
      "pull": {
        "bookmarks": null
      }
    },
    "progressAxes": {
      "pull": [
        "chapter"
      ],
      "push": [
        "chapter"
      ]
    }
  },
  "workspace": {
    "workspaceId": "plugin:hakuneko",
    "enabled": true,
    "displayLabel": "HakuNeko",
    "iconPath": "images/hakuneko-icon.svg",
    "entry": "web/index.html",
    "callbacks": [
      "get-info",
      "bookmark",
      "find-in-mangalist",
      "open-url"
    ]
  }
}
