{
  "pluginName": "hakuneko",
  "pluginType": "adapter",
  "pluginContractVersion": "3.0.0",
  "hostApiVersion": "1.0.0",
  "capabilities": [
    "file-path",
    "search.query",
    "sync.pull",
    "sync.push",
    "sync.list",
    "watch.list",
    "subscribe.add",
    "watch.summary"
  ],
  "iconPath": "images/hakuneko-icon.svg",
  "syncOptions": {
    "statusVocabulary": {
      "READING": "bookmarks",
      "COMPLETED": "bookmarks",
      "PLAN_TO_READ": "bookmarks",
      "ON_HOLD": "bookmarks",
      "DROPPED": "bookmarks",
      "RE_READING": "bookmarks"
    },
    "progressAxes": {
      "pull": ["chapter"],
      "push": ["chapter"]
    }
  },
  "workspace": {
    "workspaceId": "plugin:hakuneko",
    "enabled": true,
    "displayLabel": "HakuNeko",
    "iconPath": "images/hakuneko-icon.svg",
    "entry": "web/index.html",
    "callbacks": ["get-info", "bookmark", "find-in-mangalist", "open-url"]
  },
  "entrypoints": {
    "pluginModule": "apiwrappers/reg-hakuneko/hakuneko-plugin-module.cjs",
    "settingsFile": "apiwrappers/reg-hakuneko/hakuneko-plugin-settings.json"
  }
}
